-- 2. GHOST FLY (ADVANCED WASD + JOYSTICK + NOCLIP)
local flyActive = false
local flySpeed = 50
CreateFunction("Ghost Fly", "Полет WASD/Джойстик + NoClip", function(s)
    flyActive = s
    local char = LocalPlayer.Character
    local root = char:FindFirstChild("HumanoidRootPart")
    if s and root then
        local bv = Instance.new("BodyVelocity", root)
        local bg = Instance.new("BodyGyro", root)
        bv.MaxForce = Vector3.new(1e6, 1e6, 1e6); bv.Velocity = Vector3.new(0, 0.1, 0)
        bg.MaxTorque = Vector3.new(1e6, 1e6, 1e6); bg.CFrame = root.CFrame
        
        task.spawn(function()
            while flyActive do
                local moveDir = char.Humanoid.MoveDirection
                if moveDir.Magnitude > 0 then
                    bv.Velocity = (Camera.CFrame.LookVector * moveDir.Z * flySpeed) + (Camera.CFrame.RightVector * moveDir.X * flySpeed)
                else
                    bv.Velocity = Vector3.new(0, 0.1, 0)
                end
                bg.CFrame = Camera.CFrame
                -- NoClip Logic
                for _, part in pairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide = false end
                end
                task.wait()
            end
            bv:Destroy(); bg:Destroy()
            for _, part in pairs(char:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = true end
            end
        end)
    end
end)

