local function ToggleVisibility()
    if MainFrame.Visible then
        local t = TweenService:Create(MainFrame, Theme.Tween, {Size = UDim2.new(0, 340, 0, 0)})
        t:Play()
        t.Completed:Connect(function() MainFrame.Visible = false; RestoreBtn.Visible = true end)
    else
        RestoreBtn.Visible = false; MainFrame.Visible = true
        TweenService:Create(MainFrame, Theme.Tween, {Size = UDim2.new(0, 340, 0, 380)}):Play()
    end
end
