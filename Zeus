-- [ ЛОГИКА UI ]
local function MakeDraggable(frame)
    local dragging, dragStart, startPos
    frame.InputBegan:Connect(function(input) if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then dragging = true; dragStart = input.Position; startPos = frame.Position end end)
    UserInputService.InputChanged:Connect(function(input) if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end end)
    UserInputService.InputEnded:Connect(function() dragging = false end)
end
MakeDraggable(MainFrame); MakeDraggable(BuildHub)

local function ToggleUI()
    if MainFrame.Visible then
        local t = TweenService:Create(MainFrame, TweenInfo.new(0.6, Enum.EasingStyle.Back, Enum.EasingDirection.In), {Position = RestoreBtn.Position, Size = UDim2.new(0, 0, 0, 0), GroupTransparency = 1})
        t:Play()
        t.Completed:Connect(function() MainFrame.Visible = false; BuildHub.Visible = false; RestoreBtn.Visible = true end)
    else
        RestoreBtn.Visible = false; MainFrame.Visible = true
        MainFrame.Position = RestoreBtn.Position
        TweenService:Create(MainFrame, TweenInfo.new(0.6, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = UDim2.new(0.5, -190, 0.5, -240), Size = UDim2.new(0, 380, 0, 480), GroupTransparency = 0}):Play()
    end
end
