        Btn.Text = state and "ON" or "OFF"
        Btn.BackgroundColor3 = state and Theme.Green or Theme.Red
        callback(state)
    end)
end

-- Сворачивание (Smooth)
local function ToggleUI()
    local targetSize = MainFrame.Visible and UDim2.new(0, 360, 0, 0) or UDim2.new(0, 360, 0, 420)
    if MainFrame.Visible then
        TweenService:Create(MainFrame, TweenInfo.new(0.3), {Size = targetSize}):Play()
        task.wait(0.3)
        MainFrame.Visible = false; RestoreBtn.Visible = true; BuildFrame.Visible = false
    else
        RestoreBtn.Visible = false; MainFrame.Visible = true
        TweenService:Create(MainFrame, TweenInfo.new(0.3), {Size = targetSize}):Play()
    end
end
RestoreBtn.MouseButton1Click:Connect(ToggleUI)

