-- Логика сворачивания
local function ToggleUI()
    if MainFrame.Visible then
        local t = TweenService:Create(MainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Quart), {GroupTransparency = 1, Size = UDim2.new(0, 300, 0, 0)})
        t:Play()
        t.Completed:Connect(function() MainFrame.Visible = false; BuildHub.Visible = false; RestoreBtn.Visible = true end)
    else
        RestoreBtn.Visible = false; MainFrame.Visible = true
        TweenService:Create(MainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Quart), {GroupTransparency = 0, Size = UDim2.new(0, 380, 0, 460)}):Play()
    end
end
CloseBtn.MouseButton1Click:Connect(ToggleUI); RestoreBtn.MouseButton1Click:Connect(ToggleUI)

local function CreateToggle(name, cb)
    local s = false
    local b = Instance.new("TextButton", Scroll); b.Size = UDim2.new(1, 0, 0, 42); b.BackgroundColor3 = Theme.Secondary; b.Text = name; b.TextColor3 = Theme.Text; b.Font = Enum.Font.Gotham; b.TextSize = 13
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 10)
    b.MouseButton1Click:Connect(function() s = not s; TweenService:Create(b, TweenInfo.new(0.3), {BackgroundColor3 = s and Theme.Accent or Theme.Secondary}):Play(); cb(s) end)
end

