-- Логика сворачивания (Win11 Style)
local function ToggleUI()
    if MainFrame.Visible then
        TweenService:Create(MainFrame, TweenInfo.new(0.5, Enum.EasingStyle.Exponential), {Size = UDim2.new(0, 0, 0, 0), GroupTransparency = 1}):Play()
        task.wait(0.5); MainFrame.Visible = false; BuildHub.Visible = false; RestoreBtn.Visible = true
    else
        RestoreBtn.Visible = false; MainFrame.Visible = true
        TweenService:Create(MainFrame, TweenInfo.new(0.5, Enum.EasingStyle.Exponential), {Size = UDim2.new(0, 380, 0, 450), GroupTransparency = 0}):Play()
    end
end
CloseBtn.MouseButton1Click:Connect(ToggleUI); RestoreBtn.MouseButton1Click:Connect(ToggleUI)

local function CreateToggle(name, callback)
    local state = false
    local b = Instance.new("TextButton", Scroll)
    b.Size = UDim2.new(1, 0, 0, 40); b.BackgroundColor3 = Theme.Secondary; b.Text = name; b.TextColor3 = Theme.Text; b.Font = Enum.Font.Gotham; b.TextSize = 13
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)
    
    b.MouseButton1Click:Connect(function()
        state = not state
        TweenService:Create(b, TweenInfo.new(0.3), {BackgroundColor3 = state and Theme.Accent or Theme.Secondary}):Play()
        callback(state)
    end)
end

