local function SecureEnvironment()
    local gmt = getrawmetatable(game)
    local old_index = gmt.__index
    local old_namecall = gmt.__namecall
    setreadonly(gmt, false)

    gmt.__index = newcclosure(function(self, key)
        if not checkcaller() then
            if key == "WalkSpeed" then return 16 end
            if key == "JumpPower" then return 50 end
            if key == "Health" or key == "MaxHealth" then return 100 end
            if key == "HipHeight" then return 0 end
        end
        return old_index(self, key)
    end)

    gmt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if not checkcaller() then
            if method == "Kick" or method == "kick" then return nil end
            if method == "FireServer" and (tostring(self):find("AC") or tostring(self):find("Adonis")) then
                return nil 
            end
        end
        return old_namecall(self, ...)
    end)
    setreadonly(gmt, true)
end
SecureEnvironment()

