-- 2. PRECISION GHOST FLY
local flyActive = false
local flySpeed = 55
CreateToggle("Ghost Fly", "Полет WASD (Взгляд) + NoClip", function(s)
    flyActive = s
    local char = LocalPlayer.Character
    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    
    if s and root and hum then
        hum.PlatformStand = true
        local bv = Instance.new("BodyVelocity", root)
        local bg = Instance.new("BodyGyro", root)
        bv.MaxForce = Vector3.new(1e6, 1e6, 1e6); bv.Velocity = Vector3.new(0, 0, 0)
        bg.MaxTorque = Vector3.new(1e6, 1e6, 1e6); bg.CFrame = root.CFrame
        
        task.spawn(function()
            while flyActive do
                local moveDir = hum.MoveDirection
                local camCF = Camera.CFrame
                
                -- Расчет вектора относительно камеры (W=вперед, S=назад, A=влево, D=вправо)
                local velocity = Vector3.new(0,0,0)
                if moveDir.Magnitude > 0 then
                    velocity = camCF.LookVector * (moveDir.Z < 0 and 1 or (moveDir.Z > 0 and -1 or 0)) +
                               camCF.RightVector * (moveDir.X > 0 and 1 or (moveDir.X < 0 and -1 or 0))
                    bv.Velocity = velocity.Unit * flySpeed
                else
                    bv.Velocity = Vector3.new(0, 0, 0)
                end
                
                bg.CFrame = camCF
                for _, p in pairs(char:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = false end end
                task.wait()
            end
            bv:Destroy(); bg:Destroy()
            hum.PlatformStand = false
            for _, p in pairs(char:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = true end end
        end)
    end
end)

-- 3. BUILD HUB V3
local buildActive = false
local currentShape = 1 -- 1:Block, 2:Sphere, 3:Cylinder
local shapes = {Enum.PartType.Block, Enum.PartType.Ball, Enum.PartType.Cylinder}

CreateToggle("Build Hub", "Строительство (Клик) + Цикл форм", function(s) buildActive = s end)

UserInputService.InputBegan:Connect(function(i, g)
    if buildActive and not g then
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            local ray = Camera:ViewportPointToRay(UserInputService:GetMouseLocation().X, UserInputService:GetMouseLocation().Y)
            local hit = workspace:Raycast(ray.Origin, ray.Direction * 1000)
            if hit then
                local p = Instance.new("Part", workspace)
                p.Shape = shapes[currentShape]
                p.Size = Vector3.new(4, 4, 4); p.Anchored = true; p.Position = hit.Position + Vector3.new(0, 2, 0)
                p.Color = Theme.Accent; p.Material = Enum.Material.Neon
            end
        elseif i.KeyCode == Enum.KeyCode.R then -- Смена формы на R
            currentShape = currentShape >= #shapes and 1 or currentShape + 1
        end
    end
end)

