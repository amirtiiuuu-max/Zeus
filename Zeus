-- 2. PRECISION HEAD FLY
local flyActive = false
local flySpeed = 60
CreateToggle("Ghost Fly", "Полет по взгляду (Head)", function(s)
    flyActive = s
    local char = LocalPlayer.Character
    local root = char.HumanoidRootPart
    if s then
        char.Humanoid.PlatformStand = true
        local bv = Instance.new("BodyVelocity", root)
        local bg = Instance.new("BodyGyro", root)
        bv.MaxForce = Vector3.new(1e6, 1e6, 1e6); bv.Velocity = Vector3.new(0, 0, 0)
        bg.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
        
        task.spawn(function()
            while flyActive do
                local camCF = Camera.CFrame
                local dir = char.Humanoid.MoveDirection
                
                -- Корректное управление WASD относительно головы
                local vel = Vector3.new(0,0,0)
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then vel = vel + camCF.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then vel = vel - camCF.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then vel = vel - camCF.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then vel = vel + camCF.RightVector end
                
                bv.Velocity = vel.Unit * flySpeed
                bg.CFrame = camCF
                for _, p in pairs(char:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = false end end
                task.wait()
            end
            bv:Destroy(); bg:Destroy()
            char.Humanoid.PlatformStand = false
            for _, p in pairs(char:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = true end end
        end)
    end
end)

