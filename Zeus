-- Плавное сворачивание/развертывание
local function ToggleUI()
    if MainFrame.Visible then
        local close = TweenService:Create(MainFrame, Style.TweenInfo, {Size = UDim2.new(0, 420, 0, 0), Position = MainFrame.Position + UDim2.new(0,0,0,250)})
        close:Play()
        close.Completed:Connect(function()
            MainFrame.Visible = false
            ToggleIcon.Visible = true
            ToggleIcon.Size = UDim2.new(0,0,0,0)
            TweenService:Create(ToggleIcon, Style.TweenInfo, {Size = UDim2.new(0,60,0,60)}):Play()
        end)
    else
        ToggleIcon.Visible = false
        MainFrame.Visible = true
        MainFrame.Size = UDim2.new(0, 420, 0, 0)
        TweenService:Create(MainFrame, Style.TweenInfo, {Size = UDim2.new(0, 420, 0, 500), Position = UDim2.new(0.5, -210, 0.5, -250)}):Play()
    end
end

ToggleIcon.MouseButton1Click:Connect(ToggleUI)
UserInputService.InputBegan:Connect(function(i, g) if i.KeyCode == Enum.KeyCode.RightControl and not g then ToggleUI() end end)

-- Плавный Drag
