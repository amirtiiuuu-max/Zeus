    else
        MainFrame.Visible = true; ToggleIcon.Visible = false
        TweenService:Create(MainFrame, Style.TweenInfo, {Size = UDim2.new(0, 400, 0, 450)}):Play()
    end
end
ToggleIcon.MouseButton1Click:Connect(ToggleUI)
