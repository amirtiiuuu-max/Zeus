-- 2. ADVANCED FLY ENGINE
local flyActive = false
local flySpeed = 60
CreateToggle("Ghost Fly", "Управление по взгляду + NoClip", function(s)
    flyActive = s
    local char = LocalPlayer.Character
    local root = char:FindFirstChild("HumanoidRootPart")
    if s and root then
        local bv = Instance.new("BodyVelocity", root)
        local bg = Instance.new("BodyGyro", root)
        bv.MaxForce = Vector3.new(1e6, 1e6, 1e6); bv.Velocity = Vector3.new(0, 0, 0)
        bg.MaxTorque = Vector3.new(1e6, 1e6, 1e6); bg.CFrame = root.CFrame
        
        task.spawn(function()
            while flyActive do
                local dir = char.Humanoid.MoveDirection
                if dir.Magnitude > 0 then
                    bv.Velocity = (Camera.CFrame.LookVector * dir.Z * flySpeed) + (Camera.CFrame.RightVector * dir.X * flySpeed)
                else
                    bv.Velocity = Vector3.new(0, 0, 0)
                end
                bg.CFrame = Camera.CFrame
                for _, p in pairs(char:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = false end end
                task.wait()
            end
            bv:Destroy(); bg:Destroy()
            for _, p in pairs(char:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = true end end
        end)
    end
end)

